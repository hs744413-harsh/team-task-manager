# --- Local development ---
# Copy this file to `.env` and tweak as needed. Never commit `.env`.

# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.railway.app,.up.railway.app
CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://*.up.railway.app

# Database
# Leave DATABASE_URL empty for local SQLite, or set a Postgres URL on Railway
# (Railway auto-provisions DATABASE_URL when you attach a Postgres plugin).
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME

# Email (uses console backend by default; set SMTP creds for real email)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@taskflow.local
